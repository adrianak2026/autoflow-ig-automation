# KoshVerse platform
# Dashboard (Next.js) only — the Cloudflare Worker does not use this database.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Worker secrets are managed in Cloudflare via wrangler secret put, not here.
#   wrangler secret put VERIFY_TOKEN
#   wrangler secret put IG_ACCESS_TOKEN
#   wrangler secret put WEBHOOK_APP_SECRET
