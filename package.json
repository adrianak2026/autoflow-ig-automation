{
  "name": "autoflow-ig-automation",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"const fs=require('fs'),cp=require('child_process'); if(fs.existsSync('worker/package.json')){ cp.execSync('npm install --prefix worker', {stdio:'inherit'}); }\"",
    "verify": "bash scripts/check.sh",
    "dashboard": "bash scripts/start.sh",
    "worker:dev": "bash scripts/worker-dev.sh",
    "deploy": "npx tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
